#!/bin/bash
# Fake liquidsoap for testing

if [[ "$1" == "--version" ]]; then
    echo "Liquidsoap 2.2.5"
    exit 0
fi

if [[ "$1" == "--no-stdlib" && "$2" == "--check" ]]; then
    echo "2.2.5"
    exit 0
fi

# Playability check: if called with -c and --, validate the audio file
# Real liquidsoap would exit non-zero for invalid/missing files
for arg in "$@"; do
    if [[ "$arg" == "--" ]]; then
        shift_while=1
        continue
    fi
    if [[ -n "$shift_while" && ! -f "$arg" ]]; then
        echo "Error: file does not exist: $arg" >&2
        exit 1
    fi
done

# Default: simulate success
exit 0
